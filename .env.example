# Neon / Postgres (fase 3)
DATABASE_URL=

# Vercel Blob (fase 4)
BLOB_READ_WRITE_TOKEN=

# Admin (fase 5)
# Há tamanho mínimo obrigatório nos dois: ADMIN_PASSWORD com 16 caracteres e
# SESSION_SECRET com 32 (RFC 7518 §3.2 exige 256 bits para HS256, e a `jose`
# não reclama de chave curta por conta própria). Um valor abaixo do mínimo não
# quebra o build: a tela de login mostra apenas "Configuração de acesso
# indisponível." e o motivo real fica só no log do servidor.
# Gere valores adequados com:
#   openssl rand -base64 24   # ADMIN_PASSWORD
#   openssl rand -base64 48   # SESSION_SECRET
ADMIN_PASSWORD=
SESSION_SECRET=

# URL base — usada na OG image e no QR Code (fases 4 e 6)
# Deliberadamente VAZIA. Em desenvolvimento não precisa de valor: o código já
# cai para http://localhost:3000 sozinho. Em produção preencha com o domínio
# real, sem barra no final (ex.: https://convite.exemplo.com).
# Um valor de localhost aqui era a armadilha: "cadastre todas as variáveis em
# Production" levava esse localhost para a Vercel, onde ele é truthy — nenhum
# guarda dispara e o QR Code sai impresso apontando para a máquina de
# desenvolvimento, sem conserto com a folha já na mesa da festa.
NEXT_PUBLIC_SITE_URL=

# Teto de fotos antes de recusar novos uploads (fase 4)
# 1000 ≈ 840MB no Blob (~800KB full + ~40KB thumb por foto), com margem sobre o 1GB do plano Hobby
PHOTOS_GLOBAL_LIMIT=1000
